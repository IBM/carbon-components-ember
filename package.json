{
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/carbon-components-ember.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm build:carbon && pnpm build:docs",
    "build:carbon": "pnpm --filter carbon-components-ember build",
    "build:docs": "pnpm --filter docs-app build",
    "lint": "pnpm --filter carbon-components-ember lint",
    "lint:fix": "pnpm --filter carbon-components-ember lint:fix",
    "start": "pnpm --filter carbon-components-ember start",
    "start:docs": "concurrently 'pnpm --filter carbon-components-ember build:watch' 'pnpm --filter docs-app start' --names addon,docs --prefix-colors cyan,yellow",
    "test": "pnpm --filter carbon-components-ember test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "release-plan": "^0.16.0",
    "yaml": "^2.7.0"
  }
}
