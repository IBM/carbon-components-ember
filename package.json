{
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/carbon-components-ember.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm build:carbon && pnpm build:storybook",
    "build:carbon": "pnpm --filter carbon-components-ember build",
    "build:storybook": "pnpm --filter carbon-components-ember build-storybook",
    "lint": "pnpm --filter carbon-components-ember lint",
    "lint:fix": "pnpm --filter carbon-components-ember lint:fix",
    "start": "pnpm --filter carbon-components-ember start",
    "storybook": "pnpm --filter carbon-components-ember storybook",
    "test": "pnpm --filter carbon-components-ember test"
  },
  "devDependencies": {
    "release-plan": "^0.20.1",
    "yaml": "^2.7.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  }
}
