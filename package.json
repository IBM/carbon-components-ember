{
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github.com:IBM/carbon-components-ember.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm build:carbon && pnpm build:storybook",
    "build:carbon": "pnpm --filter carbon-components-ember build",
    "build:storybook": "pnpm --filter carbon-components-ember build-storybook",
    "format": "pnpm -r --if-present format",
    "lint": "pnpm -r --if-present lint && pnpm lint:md",
    "lint:fix": "pnpm -r --if-present lint:fix && pnpm lint:md --fix",
    "lint:md": "markdownlint-cli2",
    "start": "pnpm --filter carbon-components-ember start",
    "storybook": "pnpm --filter carbon-components-ember storybook",
    "test": "pnpm --filter carbon-components-ember test"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.3",
    "release-plan": "^0.20.1"
  },
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  }
}
