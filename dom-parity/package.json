{
  "name": "dom-parity",
  "version": "0.0.0",
  "private": true,
  "description": "Compares carbon-components-ember with a pinned @carbon/react release: DOM-parity fixtures for the addon's QUnit suite, and each component's arguments against React's props.",
  "type": "module",
  "scripts": {
    "args": "node ./arg-parity.mjs",
    "format": "prettier . --write",
    "generate": "node ./generate.mjs",
    "lint": "pnpm lint:js && pnpm lint:format",
    "lint:fix": "eslint . --fix && prettier . --write",
    "lint:format": "prettier . --check",
    "lint:js": "eslint .",
    "test": "node --test"
  },
  "devDependencies": {
    "@carbon/react": "catalog:carbon",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "catalog:typescript"
  }
}
