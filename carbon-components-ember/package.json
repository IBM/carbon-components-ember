{
  "name": "carbon-components-ember",
  "version": "3.0.0",
  "description": "Ember components for the IBM Carbon Design System",
  "keywords": [
    "ember-addon"
  ],
  "repository": "https://github.com/IBM/carbon-components-ember",
  "license": "MIT",
  "author": "Patrick Pircher",
  "imports": {
    "#src/*": "./src/*",
    "#storybook/*": "./.storybook/*"
  },
  "exports": {
    ".": {
      "types": "./declarations/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./declarations/*.d.ts",
      "default": "./dist/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./addon-main.js": "./addon-main.cjs"
  },
  "files": [
    "addon-main.cjs",
    "declarations",
    "dist",
    "skills",
    "src",
    "!src/**/*.stories.*"
  ],
  "scripts": {
    "build": "rollup --config",
    "build:skill": "storybook build --quiet && pnpm generate:skill-references",
    "build:watch": "rollup --config --watch --no-watch.clearScreen",
    "generate": "pnpm generate:icons && pnpm generate:barrels",
    "generate:barrels": "node ./scripts/barrels.mjs",
    "generate:icons": "node ./scripts/icons.mjs",
    "generate:skill-references": "node ./scripts/skill-references.mjs",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:publish": "pnpm build && publint run --level error",
    "lint:types": "ember-tsc --noEmit",
    "prepack": "pnpm generate && rollup --config && pnpm build:skill",
    "start": "vite dev",
    "test": "vite build --mode=development --out-dir dist-tests && testem --file testem.cjs ci --port 0",
    "test:update-snapshots": "vite build --mode=development --out-dir dist-tests && UPDATE_SNAPSHOTS=true testem --file testem.cjs ci --port 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.0",
    "@carbon/grid": "catalog:carbon",
    "@carbon/icon-helpers": "catalog:carbon",
    "@carbon/icons": "catalog:carbon",
    "@carbon/layout": "catalog:carbon",
    "@carbon/styles": "catalog:carbon",
    "@carbon/utilities": "catalog:carbon",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@embroider/addon-shim": "^1.10.3",
    "@lezer/highlight": "1.2.5",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-hard-break": "3.31.4",
    "@tiptap/extension-mention": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/suggestion": "3.31.4",
    "decorator-transforms": "^2.4.0",
    "dompurify": "3.4.16",
    "ember-basic-dropdown": "^9.0.0",
    "ember-concurrency": "^5.3.0",
    "ember-lifeline": "^7.1.0",
    "ember-modifier": "^4.2.2",
    "ember-power-select": "^9.0.2",
    "ember-primitives": "^0.62.0",
    "ember-resize-modifier": "^1.1.0",
    "ember-style-modifier": "^4.6.0",
    "flatpickr": "^4.6.13",
    "markdown-it": "14.3.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@babel/runtime": "^8.0.7",
    "@carbon/ai-chat-components": "catalog:carbon",
    "@carbon/themes": "catalog:carbon",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/library-tsconfig": "^3.0.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/addon-dev": "^8.4.2",
    "@embroider/core": "^4.6.9",
    "@embroider/macros": "^1.21.3",
    "@embroider/vite": "^1.7.15",
    "@eslint/js": "^10.0.1",
    "@glimmer/component": "^2.1.1",
    "@glint/ember-tsc": "^1.11.6",
    "@glint/template": "^1.9.0",
    "@glint/tsserver-plugin": "^2.7.9",
    "@rollup/plugin-babel": "^7.1.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@types/markdown-it": "^14.2.0",
    "@types/qunit": "^2.19.14",
    "@types/react": "^19.3.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^10.0.6",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.2.0",
    "ember-source": "^7.3.1",
    "ember-storybook": "^0.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^13.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-qunit": "^8.2.6",
    "globals": "^17.13.0",
    "playwright": "^1.63.0",
    "playwright-chromium": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "publint": "^0.3.25",
    "qunit": "^3.0.0",
    "qunit-dom": "^3.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.64.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-sass": "1.15.3",
    "sass-embedded": "^1.105.1",
    "storybook": "^10.6.1",
    "testem": "^3.21.3",
    "typescript": "catalog:typescript",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^5.0.3"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "version": 2,
    "type": "addon",
    "main": "addon-main.cjs",
    "app-js": {
      "./services/carbon/ai-chat-session.js": "./dist/_app_/services/carbon/ai-chat-session.js",
      "./services/carbon/dialog-manager.js": "./dist/_app_/services/carbon/dialog-manager.js",
      "./services/carbon/notifications.js": "./dist/_app_/services/carbon/notifications.js"
    }
  }
}
