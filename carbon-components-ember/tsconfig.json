/**
 * This tsconfig is not used for publishing.
 * It's only for the local editing experience
 * (and linting)
 */
{
  "extends": "@ember/app-tsconfig",
  "include": [
    "src/**/*",
    "tests/**/*",
    "unpublished-development-types/**/*",
    "demo-app/**/*",
    ".storybook/**/*"
  ],
  "compilerOptions": {
    // The DOM-parity tests import the untyped ../dom-parity/lib/*.mjs
    // helpers, which live outside this package.
    "rootDir": "..",
    "allowJs": true,
    // The tests import JSON fixtures (DOM parity).
    "resolveJsonModule": true,
    "types": [
      "ember-source/types",
      "vite/client",
      "@embroider/core/virtual",
      "@glint/ember-tsc/types"
    ]
  },
  "contentMappers": [
    {
      "package": "ember-content-mapper",
      "extensions": [".gts", ".gjs"]
    }
  ]
}
